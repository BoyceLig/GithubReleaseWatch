<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GithubReleaseWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GithubReleaseWatch"
        Title="GithubReleaseWatch — GitHub Release 版本监测"
        Icon="GithubReleaseWatch.ico"
        Height="700" Width="1150" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ContextMenu x:Key="RepoItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="🔄 刷新此仓库" Click="CtxRefreshRepo_Click"/>
            <MenuItem Header="🌐 在 GitHub 打开" Click="CtxOpenGitHub_Click"/>
            <Separator/>
            <MenuItem Header="🗑 移除此仓库" Click="CtxRemoveRepo_Click"/>
        </ContextMenu>
    </Window.Resources>
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" Padding="10,8"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnRefresh" Content="🔄 刷新全部" Padding="12,5" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnAdd" Content="➕ 添加仓库" Padding="12,5" Margin="8,0,0,0" Click="BtnAdd_Click"/>
                    <Button x:Name="BtnRemove" Content="🗑 移除选中" Padding="12,5" Margin="8,0,0,0" Click="BtnRemove_Click"/>
                    <CheckBox x:Name="ChkPrerelease" Content="显示 Pre-release" VerticalAlignment="Center"
                              Margin="24,0,0,0" Checked="ChkPrerelease_Changed" Unchecked="ChkPrerelease_Changed"/>
                    <Button x:Name="BtnSettings" Content="⚙ 设置" Padding="12,5" Margin="24,0,0,0" Click="BtnSettings_Click"/>
                    <TextBlock x:Name="TxtRateLimit" VerticalAlignment="Center" Margin="24,0,0,0" Foreground="#374151" FontSize="12"
                               ToolTip="GitHub API 当前已用/剩余配额（/rate_limit 端点不计配额，可随时刷新）"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnAbout" Content="ℹ️ 关于"
                        HorizontalAlignment="Right" Padding="12,5" Click="BtnAbout_Click"/>
            </Grid>
        </Border>

        <!-- 底部状态栏：右下角显示操作日志 -->
        <Border DockPanel.Dock="Bottom" Background="#F3F4F6" Padding="10,6"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Foreground="#6B7280" FontSize="12"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：仓库列表（关闭虚拟化以便拖拽排序时能稳定访问所有容器） -->
            <ListBox x:Name="RepoList" Grid.Column="0"
                     SelectionChanged="RepoList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     BorderThickness="0,0,1,0" Background="#FAFAFA" Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <!-- 拖拽事件（Move/Up 兜在 ListBox 上，确保鼠标捕获仍稳定） -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RepoListItem_PreviewMouseLeftButtonDown"/>
                        <!-- 右上角右键菜单 -->
                        <Setter Property="ContextMenu" Value="{StaticResource RepoItemContextMenu}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                                               Foreground="#111827" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" CornerRadius="9" Padding="8,2" Background="{Binding BadgeBrush}">
                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="当前: " Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="12" Margin="0,0,12,0"/>
                                    <TextBlock Text="最新: " Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock Text="{Binding LatestVersion}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" Background="#E5E7EB"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- 右侧：选中仓库的版本详情 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                         x:Name="RightScrollViewer">
                <StackPanel Margin="14,12">
                    <TextBlock x:Name="Placeholder" Text="← 在左侧选择一个仓库，查看最近版本和版本说明"
                               Foreground="#9CA3AF" FontSize="14" Margin="0,20,0,0"/>

                    <StackPanel x:Name="DetailsContent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold"
                                       Foreground="#111827" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="🌐 在 GitHub 打开" Click="BtnOpenGitHub_Click" Padding="10,4"/>
                            <Button Grid.Column="2" Content="✅ 完成：升级到最新版本" Click="BtnComplete_Click"
                                    Padding="10,4" FontWeight="Bold" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#374151">
                            <Run Text="当前版本："/><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="　　最新版本："/><Run Text="{Binding LatestVersion, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ErrorText}" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Separator Margin="0,14"/>

                        <!-- 固定标题栏：不随版本列表滚动 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最近版本（最多 3 个）" FontSize="13" Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Content="▶ 全部展开" x:Name="BtnToggleAllVersions"
                                          Padding="8,2" FontSize="11" Checked="BtnToggleAllVersions_Checked"
                                          Unchecked="BtnToggleAllVersions_Unchecked" IsChecked="True"/>
                        </Grid>

                        <!-- 版本列表：三个版本共用外层 RightScrollViewer 滚动，卡片本身不滚动 -->
                        <ItemsControl ItemsSource="{Binding VisibleReleases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                            PreviewMouseWheel="VersionBody_PreviewMouseWheel">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TagName}" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                                                    <Border Background="#F59E0B" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                                            Visibility="{Binding Prerelease, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Pre-release" Foreground="White" FontSize="10"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding PublishedAtText}" Foreground="#6B7280" FontSize="11"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="📋 复制 Markdown" Click="BtnCopyMarkdown_Click"
                                                            Padding="7,2" FontSize="11" Margin="0,0,6,0"
                                                            ToolTip="复制该版本的 Markdown 原文"/>
                                                    <Button Content="设为当前版本" Click="BtnMarkRelease_Click"
                                                            Padding="8,2" FontSize="11"/>
                                                </StackPanel>
                                                <!-- 折叠/展开切换按钮 -->
                                                <ToggleButton Grid.Column="2" Content="▼" x:Name="BtnToggleVersionBody"
                                                               Padding="6,2" FontSize="11" Width="32"
                                                               IsChecked="True" Click="BtnToggleVersionBody_Click"/>
                                            </Grid>
                                            <!-- 版本说明：由 GitHub /markdown API 渲染后的 HTML；
                                                 用 Border 限定可见区域，防止 WebBrowser (HwndHost) 覆盖上下控件。 -->
                                            <Border x:Name="VersionBodyBorder" Background="Transparent"
                                                    Margin="0,8,0,0" ClipToBounds="True">
                                                <WebBrowser local:WebBrowserHelper.BindableHtml="{Binding BodyHtml}"
                                                            local:WebBrowserHelper.AutoHeight="True"
                                                            Focusable="False"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
