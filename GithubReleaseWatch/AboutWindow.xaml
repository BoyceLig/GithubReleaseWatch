<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GithubReleaseWatch.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="GithubReleaseWatch.ico" Title="关于"
        Width="500" Height="540" SizeToContent="Height"
        MinHeight="380" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,24">
        <!-- 头部 -->
        <StackPanel HorizontalAlignment="Center">
            <Image x:Name="ImgIcon" Width="84" Height="84"
                   Margin="0,0,0,12" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" Source="/AppIcon.png"/>
            <TextBlock Text="GithubReleaseWatch" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="GitHub Release 版本监测工具" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Margin="0,20,0,16"/>

        <!-- 信息表：Grid 两列 Auto + *，行数按实际内容定义 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="78" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="17"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="作者" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Boyce Lig" FontWeight="Bold" Margin="0,3,0,3" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="GitHub" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGithub" Foreground="#2563EB" Cursor="Hand"
                       MouseDown="TxtGithub_MouseDown" TextDecorations="Underline" ToolTip="点击访问"
                       TextWrapping="Wrap" Margin="0,3,0,3" Text="https://github.com/BoyceLig/GithubReleaseWatch" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="当前版本" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtVersion" FontWeight="Bold" Margin="0,3,0,3" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="运行时" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtRuntime" Margin="0,3,0,3" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="技术栈" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="WPF / .NET 8" Margin="0,3,0,3" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="开源许可" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="非商业许可：可修改、可二创，不可商用"
                       TextWrapping="Wrap" Foreground="#374151" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="机场推荐" Foreground="#6B7280" Margin="0,3,14,3" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtGithub2" Foreground="#2563EB" Cursor="Hand"
                MouseDown="TxtGithub_MouseDown" TextDecorations="Underline" ToolTip="点击访问"
                TextWrapping="Wrap" Margin="0,3,0,3" Text="https://github.com/BoyceLig/ProxyRecommendations" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
        </Grid>

        <Separator Margin="0,18,0,16"/>

        <Button Content="关闭" Padding="28,7" HorizontalAlignment="Center" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
