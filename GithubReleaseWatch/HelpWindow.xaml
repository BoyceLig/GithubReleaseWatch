<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GithubReleaseWatch.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="GithubReleaseWatch.ico" Title="申请流程参考 — GithubReleaseWatch" Height="640" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="20">
            <TextBlock Text="申请流程参考" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>

            <!-- Token 申请流程 -->
            <Border Background="#F0F9FF" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔑 GitHub Token 申请流程（推荐）" FontSize="15" FontWeight="Bold" Foreground="#0C4A6E"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="13" LineHeight="22" Margin="0,8,0,0">
                        <Run Text="Token 用于将 API 速率限制从 60/小时提升到 5000/小时，按 Token 独立计数，不受代理节点共享影响。"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="#1F2937" FontSize="13" LineHeight="22" Margin="0,8,0,0">
                        <Run Text="步骤："/>
                        <LineBreak/>
                        <Run Text="  1. 打开 https://github.com/settings/tokens/new"/>
                        <LineBreak/>
                        <Run Text="  2. 登录 GitHub 账号（没有就注册一个）"/>
                        <LineBreak/>
                        <Run Text="  3. Note（备注）填：" Foreground="#374151"/><Run Text="GithubReleaseWatch" FontWeight="Bold"/><Run Text="（便于日后识别）"/>
                        <LineBreak/>
                        <Run Text="  4. Expiration（有效期）：选 90 天 / No expiration"/>
                        <LineBreak/>
                        <Run Text="  5. Scopes（权限范围）：" Foreground="#374151"/><Run Text="全部不勾" FontWeight="Bold" Foreground="#DC2626"/><Run Text=" —— 只读公开仓库不需要任何权限"/>
                        <LineBreak/>
                        <Run Text="  6. 滚动到底部点「Generate token」生成"/>
                        <LineBreak/>
                        <Run Text="  7. ⚠ 立刻复制显示的 token（格式 ghp_xxx...）—— 关掉页面就再也看不到了"/>
                        <LineBreak/>
                        <Run Text="  8. 粘贴到设置窗口的「GitHub Token」框"/>
                        <LineBreak/>
                        <Run Text="  9. 勾选「启用 Token」，然后点「🔑 测试 Token」验证" Foreground="#374151"/>
                        <LineBreak/>
                        <Run Text="     应显示：" Foreground="#374151"/><Run Text="「5000 / 5000 次/小时」" FontWeight="Bold" Foreground="#16A34A"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 代理申请流程 -->
            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🌐 网络代理申请流程" FontSize="15" FontWeight="Bold" Foreground="#78350F"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="13" LineHeight="22" Margin="0,8,0,0">
                        <Run Text="代理不是必须的 —— 只有当你无法直连 GitHub 时才需要。本工具支持 HTTP 和 SOCKS5 两种协议。"/>
                    </TextBlock>

                    <TextBlock Text="方式 A：使用代理客户端（最常见）" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="0,14,0,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#1F2937" FontSize="13" LineHeight="22" Margin="0,6,0,0">
                        <Run Text="  1. 启动你的代理客户端：" Foreground="#374151"/><Run Text="Clash / Clash Verge / V2rayN / NekoBox / 机场客户端" FontWeight="Bold"/><Run Text=" 等"/>
                        <LineBreak/>
                        <Run Text="  2. 在客户端「系统代理 / 端口设置」里找到本地监听端口：" Foreground="#374151"/>
                    </TextBlock>
                    <Border Background="White" CornerRadius="4" Padding="10,6" Margin="20,4,20,0">
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#1F2937" LineHeight="18">
                            <Run Text="Clash Verge   默认：" Foreground="#6B7280"/><Run Text="  7897 (SOCKS5)  /  7890 (HTTP)" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="Clash for Win 默认：" Foreground="#6B7280"/><Run Text="  7890 (HTTP)" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="V2rayN        默认：" Foreground="#6B7280"/><Run Text="  10808 (SOCKS5)" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="Shadowsocks   默认：" Foreground="#6B7280"/><Run Text="  1080 (SOCKS5)" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Foreground="#1F2937" FontSize="13" LineHeight="22" Margin="0,8,0,0">
                        <Run Text="  3. 在本工具「启用代理」打勾，类型选 HTTP 或 SOCKS5，IP 填" Foreground="#374151"/><Run Text=" 127.0.0.1" FontWeight="Bold"/><Run Text="，端口填上一步那个"/>
                        <LineBreak/>
                        <Run Text="  4. 如果代理要求认证，填用户名和密码"/>
                        <LineBreak/>
                        <Run Text="  5. 点「🔌 测试代理」验证（应显示「走代理 xx:xx 可访问 GitHub API」）"/>
                    </TextBlock>

                    <TextBlock Text="方式 B：付费机场节点（直接给 IP + 端口 + 账密）" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="0,14,0,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#1F2937" FontSize="13" LineHeight="22" Margin="0,6,0,0">
                        <Run Text="  把机场提供的「服务器地址」「端口」「用户名」「密码」直接填进来即可，类型通常是 HTTP 或 SOCKS5。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 配额规则说明 -->
            <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="⚠ 配额统计规则（重要）" FontSize="14" FontWeight="Bold" Foreground="#991B1B"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#1F2937" FontSize="13" LineHeight="22" Margin="0,8,0,0">
                        <Run Text="· " Foreground="#374151"/><Run Text="未认证 API 配额按「出口 IP」统计：60 次/小时。" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="· 使用公共代理/机场节点时，同一出口 IP 的其他用户会把额度用光。" Foreground="#374151"/>
                        <LineBreak/>
                        <Run Text="· 配置 GitHub Token：5000 / 小时，" Foreground="#374151"/><Run Text="按 Token 独立计数" FontWeight="Bold"/><Run Text="，不受出口 IP 影响。"/>
                        <LineBreak/>
                        <Run Text="· "/><Run Text="/rate_limit 端点不计配额" FontWeight="Bold" Foreground="#16A34A"/><Run Text="，所以测试 / 显示配额随时可用，不会消耗次数。" Foreground="#374151"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Content="关闭" Padding="20,6" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>