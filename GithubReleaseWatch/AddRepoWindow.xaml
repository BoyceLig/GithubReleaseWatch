<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GithubReleaseWatch.AddRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="GithubReleaseWatch.ico" Title="添加仓库" Height="260" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="GitHub 仓库地址"/>
        <TextBox x:Name="TxtUrl" Height="26" Margin="0,4,0,0"/>
        <TextBlock Text="当前版本号（可留空，默认取最新版本）" Margin="0,12,0,0"/>
        <TextBox x:Name="TxtVersion" Height="26" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Padding="14,4" IsCancel="True"/>
            <Button Content="添加" Padding="14,4" Margin="8,0,0,0" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
