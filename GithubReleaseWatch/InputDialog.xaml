<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GithubReleaseWatch.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="GithubReleaseWatch.ico" Title="输入" Height="230" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="LblPrompt" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtValue" Height="26" Margin="0,8,0,0"/>
        <TextBlock Text="Token 只保存在本地 config.json 中，不会上传到任何服务器。"
                   Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Padding="14,4" IsCancel="True"/>
            <Button Content="保存" Padding="14,4" Margin="8,0,0,0" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
